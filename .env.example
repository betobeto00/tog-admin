# TOG Admin — variables de entorno (plantilla, sin secretos)
#
# Copia este archivo como `.env` y rellena los valores:
#   cp .env.example .env
#
# Ubicación efectiva:
#   - Dev:   <repo>/.env
#   - Prod:  %APPDATA%/tog-admin/.env   (mismo directorio que la base SQLite)
#
# NUNCA commitees tu `.env` real: ya está bloqueado por .gitignore.

# Bot de Telegram para el botón de feedback del login.
# Crea el bot con @BotFather y pega aquí el token.
TELEGRAM_BOT_TOKEN=

# Chat/grupo/canal al que llegan los mensajes de feedback.
# Para grupos/canales usa el id negativo (ej. -100123456789).
TELEGRAM_CHAT_ID=
