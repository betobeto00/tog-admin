{
  "name": "tog-admin",
  "version": "1.0.8",
  "description": "TOG Admin - Ecosistema modular de punto de venta y gestión para cualquier negocio, de la producción a la postventa",
  "main": "dist-electron/main/index.js",
  "author": "betobeto00",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build && node scripts/inline-css.js",
    "build:main": "tsc -p tsconfig.main.json",
    "rebuild": "electron-rebuild --force",
    "build:win": "npm run rebuild && npm run build:renderer && npm run build:main && electron-builder --win --dir",
    "build:installer": "npm run rebuild && npm run build:renderer && npm run build:main && electron-builder --win nsis",
    "build:portable": "npm run rebuild && npm run build:renderer && npm run build:main && electron-builder --win --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:main",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/main/db/migrate.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.23.0",
    "recharts": "^3.10.1",
    "serialport": "^13.0.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.11.0",
    "typescript": "5.4",
    "vite": "^5.2.0",
    "vitest": "^4.1.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tog.admin",
    "productName": "TOG Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "src/main/i18n/locales/**/*",
      "packaging/installer.nsh"
    ],
    "extraResources": [
      {
        "from": "src/main/i18n/locales",
        "to": "i18n/locales",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          ".env"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TOG Admin",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "packaging/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "betobeto00",
      "repo": "tog-admin"
    }
  }
}
